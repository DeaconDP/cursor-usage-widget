<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DeezFuelGauge.MainWindow"
        xmlns:settings="using:DeezFuelGauge.Settings"
        Title="Cursor Usage"
        Width="300"
        SizeToContent="Height"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        PointerPressed="Window_PointerPressed"
        PointerEntered="Window_PointerEntered"
        PointerExited="Window_PointerExited"
        PointerReleased="Window_PointerReleased">
    <Border x:Name="PillBorder"
            CornerRadius="10"
            Background="#E6181818"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            Padding="10,9,10,12"
            ClipToBounds="True">
        <Border.ContextMenu>
            <ContextMenu Opening="WidgetContextMenu_Opening"
                         Closing="WidgetContextMenu_Closing">
                <MenuItem x:Name="CompactModeMenuItem"
                          Header="Compact mode"
                          ToggleType="CheckBox"
                          Click="CompactModeMenuItem_Click" />
                <MenuItem Header="Refresh" Click="RefreshMenuItem_Click" />
                <Separator />
                <MenuItem Header="Quit" Click="QuitMenuItem_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid x:Name="ContentHost"
              ClipToBounds="True">
            <StackPanel x:Name="CompactRow"
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Opacity="0">
                <TextBlock Text="&#x1F701;"
                           FontSize="14"
                           LineHeight="18"
                           Foreground="#CC00E5FF"
                           VerticalAlignment="Top"
                           Margin="0,1,0,0" />
                <StackPanel x:Name="CompactSourcesPanel"
                            Spacing="2" />
            </StackPanel>
            <StackPanel x:Name="FullContent">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="&#x1F701;"
                               FontSize="15"
                               LineHeight="18"
                               Foreground="#CC00E5FF"
                               Margin="0,0,7,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Deez Fuel Gauge"
                               FontFamily="Segoe UI Semibold, Segoe UI, sans-serif"
                               FontSize="13"
                               FontWeight="SemiBold"
                               LineHeight="18"
                               Foreground="#FF00E5FF"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="Transparent"
                            Cursor="Hand"
                            Padding="2,0,0,0"
                            ToolTip.Tip="Settings"
                            PointerPressed="SettingsToggle_PointerPressed">
                        <TextBlock x:Name="SettingsIcon"
                                   Text="&#x2699;"
                                   FontFamily="Segoe UI Symbol, Apple Symbols, sans-serif"
                                   FontSize="14"
                                   LineHeight="18"
                                   Foreground="#FF44CC44"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Background="Transparent"
                            Cursor="Hand"
                            Margin="6,0,0,0"
                            ToolTip.Tip="Refresh"
                            PointerPressed="RefreshButton_PointerPressed">
                        <TextBlock x:Name="RefreshIcon"
                                   Text="&#x21BB;"
                                   FontFamily="Segoe UI Symbol, Apple Symbols, sans-serif"
                                   FontSize="14"
                                   LineHeight="18"
                                   Foreground="#FF88CCFF"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="CompactModeButton"
                            Background="Transparent"
                            Cursor="Hand"
                            Margin="6,0,0,0"
                            PointerPressed="CompactModeToggle_PointerPressed">
                        <TextBlock x:Name="CompactModeIcon"
                                   Text="&#x25EB;"
                                   FontFamily="Segoe UI Symbol, Apple Symbols, sans-serif"
                                   FontSize="14"
                                   LineHeight="18"
                                   Foreground="#FF88CCFF"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="PinButton"
                            Background="Transparent"
                            Cursor="Hand"
                            Margin="6,0,0,0"
                            PointerPressed="PinToggle_PointerPressed">
                        <TextBlock x:Name="PinIcon"
                                   Text="&#x2316;"
                                   FontFamily="Segoe UI Symbol, Apple Symbols, sans-serif"
                                   FontSize="14"
                                   LineHeight="18"
                                   Foreground="#FFFFCC00"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Background="Transparent"
                            Cursor="Hand"
                            Margin="6,0,0,0"
                            ToolTip.Tip="Close"
                            PointerPressed="CloseButton_PointerPressed">
                        <TextBlock Text="&#x2715;"
                                   FontFamily="Segoe UI Symbol, Apple Symbols, sans-serif"
                                   FontSize="14"
                                   LineHeight="18"
                                   Foreground="#FFFF4444"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
            <Border x:Name="SettingsPanelHost"
                    Margin="0,0,0,8"
                    Padding="0"
                    CornerRadius="6"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    IsVisible="False">
                <settings:SettingsPanel x:Name="SettingsPanelControl" />
            </Border>
            <StackPanel x:Name="CursorProviderSection">
                <Border x:Name="CursorProviderHeader"
                        Background="Transparent"
                        Margin="0,0,0,4"
                        IsVisible="False">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Cursor"
                                   FontFamily="Segoe UI Semibold, Segoe UI, sans-serif"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFB0B0B0" />
                        <Grid x:Name="CursorHeadlineTrack"
                              Height="6">
                            <Border CornerRadius="3" Background="#33FFFFFF" />
                            <Border x:Name="CursorHeadlineFill"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    Width="0"
                                    Background="#FF4CAF50" />
                        </Grid>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="CursorDetailsPanel" IsVisible="True">
            <StackPanel x:Name="CursorSection">
                <TextBlock x:Name="PercentText"
                           Text="..."
                           FontSize="11"
                           FontWeight="SemiBold"
                           LineHeight="15"
                           Foreground="#FFE8E8E8" />
                <Border x:Name="CursorBarBorder"
                        Background="Transparent">
                    <StackPanel Margin="0,5,0,5" Spacing="2">
                        <TextBlock Text="Cursor"
                                   FontFamily="Segoe UI Semibold, Segoe UI, sans-serif"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFB0B0B0" />
                        <Grid x:Name="ProgressTrack"
                              Height="6">
                            <Border CornerRadius="3" Background="#33FFFFFF" />
                            <Border x:Name="ProgressFill"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    Width="0"
                                    Background="#FF4CAF50" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="BreakdownPanel"
                        Margin="0,3,0,0"
                        Padding="6,5"
                        CornerRadius="5"
                        Background="#FF252525"
                        IsVisible="False">
                    <StackPanel Spacing="5">
                        <Border x:Name="AutoBreakdownRow"
                                Classes="breakdown-row"
                                Background="Transparent">
                            <StackPanel>
                                <Grid Margin="0,0,0,2" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Text="Cursor Models"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LineHeight="15"
                                               Foreground="#FFE8E8E8"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="AutoResetText"
                                               Grid.Column="1"
                                               Margin="6,0,6,0"
                                               FontSize="9"
                                               LineHeight="12"
                                               Foreground="#FF777777"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="AutoPercentText"
                                               Grid.Column="2"
                                               Text=""
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LineHeight="15"
                                               Foreground="#FFE8E8E8"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Grid x:Name="AutoProgressTrack" Height="6">
                                    <Border CornerRadius="3" Background="#33FFFFFF" />
                                    <Border x:Name="AutoProgressFill"
                                            CornerRadius="3"
                                            HorizontalAlignment="Left"
                                            Width="0"
                                            Background="#FF4D9FFF" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ApiBreakdownRow"
                                Classes="breakdown-row"
                                Background="Transparent">
                            <StackPanel>
                                <Grid Margin="0,0,0,2" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Text="Cursor API"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LineHeight="15"
                                               Foreground="#FFE8E8E8"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ApiResetText"
                                               Grid.Column="1"
                                               Margin="6,0,6,0"
                                               FontSize="9"
                                               LineHeight="12"
                                               Foreground="#FF777777"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ApiPercentText"
                                               Grid.Column="2"
                                               Text=""
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LineHeight="15"
                                               Foreground="#FFE8E8E8"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Grid x:Name="ApiProgressTrack" Height="6">
                                    <Border CornerRadius="3" Background="#33FFFFFF" />
                                    <Border x:Name="ApiProgressFill"
                                            CornerRadius="3"
                                            HorizontalAlignment="Left"
                                            Width="0"
                                            Background="#FF4D9FFF" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="GrokBotBreakdownRow"
                                Classes="breakdown-row"
                                Background="Transparent"
                                IsVisible="False">
                            <StackPanel>
                                <Grid Margin="0,0,0,2" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Text="Grok Bot"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LineHeight="15"
                                               Foreground="#FFE8E8E8"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="GrokBotResetText"
                                               Grid.Column="1"
                                               Margin="6,0,6,0"
                                               FontSize="9"
                                               LineHeight="12"
                                               Foreground="#FF777777"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="GrokBotPercentText"
                                               Grid.Column="2"
                                               Text=""
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LineHeight="15"
                                               Foreground="#FFE8E8E8"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Grid x:Name="GrokBotProgressTrack" Height="6">
                                    <Border CornerRadius="3" Background="#33FFFFFF" />
                                    <Border x:Name="GrokBotProgressFill"
                                            CornerRadius="3"
                                            HorizontalAlignment="Left"
                                            Width="0"
                                            Background="#FF4D9FFF" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="RemainingText"
                           Text=""
                           FontSize="11"
                           LineHeight="15"
                           Foreground="#FFB0B0B0" />
            </StackPanel>
            <StackPanel x:Name="OpenAiSection" Margin="0,8,0,4" Spacing="2">
                <TextBlock Text="Cursor OpenAI"
                           FontFamily="Segoe UI Semibold, Segoe UI, sans-serif"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#FFB0B0B0" />
                <Grid x:Name="OpenAiProgressTrack"
                      Height="6">
                    <Border CornerRadius="3" Background="#33FFFFFF" />
                    <Border x:Name="OpenAiProgressFill"
                            CornerRadius="3"
                            HorizontalAlignment="Left"
                            Width="0"
                            Background="#FF4CAF50" />
                </Grid>
            </StackPanel>
            <TextBlock x:Name="OpenAiDetailText"
                       Margin="0,2,0,4"
                       FontSize="9"
                       LineHeight="12"
                       Foreground="#FF777777"
                       IsVisible="False" />
            <StackPanel x:Name="ClaudeSection" Margin="0,0,0,4" Spacing="2">
                <TextBlock Text="Cursor Claude"
                           FontFamily="Segoe UI Semibold, Segoe UI, sans-serif"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#FFB0B0B0" />
                <Grid x:Name="ClaudeProgressTrack"
                      Height="6">
                    <Border CornerRadius="3" Background="#33FFFFFF" />
                    <Border x:Name="ClaudeProgressFill"
                            CornerRadius="3"
                            HorizontalAlignment="Left"
                            Width="0"
                            Background="#FF4CAF50" />
                </Grid>
            </StackPanel>
            <TextBlock x:Name="ClaudeDetailText"
                       Margin="0,2,0,4"
                       FontSize="9"
                       LineHeight="12"
                       Foreground="#FF777777"
                       IsVisible="False" />
            <StackPanel x:Name="GeminiSection" Margin="0,0,0,4" Spacing="2">
                <TextBlock Text="Cursor Gemini"
                           FontFamily="Segoe UI Semibold, Segoe UI, sans-serif"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#FFB0B0B0" />
                <Grid x:Name="GeminiProgressTrack"
                      Height="6">
                    <Border CornerRadius="3" Background="#33FFFFFF" />
                    <Border x:Name="GeminiProgressFill"
                            CornerRadius="3"
                            HorizontalAlignment="Left"
                            Width="0"
                            Background="#FF4CAF50" />
                </Grid>
            </StackPanel>
            <TextBlock x:Name="GeminiDetailText"
                       Margin="0,2,0,0"
                       FontSize="9"
                       LineHeight="12"
                       Foreground="#FF777777"
                       IsVisible="False" />
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="OpenAiProviderSection">
                <Border x:Name="OpenAiProviderHeader"
                        Background="Transparent"
                        Margin="0,0,0,4"
                        IsVisible="False">
                    <StackPanel Spacing="2">
                        <TextBlock Text="OpenAI"
                                   FontFamily="Segoe UI Semibold, Segoe UI, sans-serif"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFB0B0B0" />
                        <Grid x:Name="OpenAiHeadlineTrack"
                              Height="6">
                            <Border CornerRadius="3" Background="#33FFFFFF" />
                            <Border x:Name="OpenAiHeadlineFill"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    Width="0"
                                    Background="#FF4CAF50" />
                        </Grid>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="OpenAiDetailsPanel" IsVisible="True">
            <StackPanel x:Name="OpenAiDirectSection" Margin="0,0,0,4" Spacing="2">
                <TextBlock Text="OpenAI API"
                           FontFamily="Segoe UI Semibold, Segoe UI, sans-serif"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#FFB0B0B0" />
                <Grid x:Name="OpenAiDirectProgressTrack"
                      Height="6">
                    <Border CornerRadius="3" Background="#33FFFFFF" />
                    <Border x:Name="OpenAiDirectProgressFill"
                            CornerRadius="3"
                            HorizontalAlignment="Left"
                            Width="0"
                            Background="#FF4CAF50" />
                </Grid>
            </StackPanel>
            <TextBlock x:Name="OpenAiDirectDetailText"
                       Margin="0,2,0,4"
                       FontSize="9"
                       LineHeight="12"
                       Foreground="#FF777777"
                       IsVisible="False" />
            <StackPanel x:Name="CodexLimitsSection" IsVisible="False">
                <TextBlock x:Name="CodexPercentText"
                           Text="..."
                           FontSize="11"
                           FontWeight="SemiBold"
                           LineHeight="15"
                           Foreground="#FFE8E8E8" />
                <Border x:Name="CodexBarBorder"
                        Background="Transparent">
                    <StackPanel Margin="0,5,0,5" Spacing="2">
                        <TextBlock Text="OpenAI Codex"
                                   FontFamily="Segoe UI Semibold, Segoe UI, sans-serif"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFB0B0B0" />
                        <Grid x:Name="CodexProgressTrack"
                              Height="6">
                            <Border CornerRadius="3" Background="#33FFFFFF" />
                            <Border x:Name="CodexProgressFill"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    Width="0"
                                    Background="#FF4CAF50" />
                        </Grid>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="CodexBreakdownSection"
                            IsVisible="False">
                    <Border x:Name="CodexBreakdownPanel"
                            Margin="0,3,0,0"
                            Padding="6,5"
                            CornerRadius="5"
                            Background="#FF252525">
                        <StackPanel Spacing="5">
                            <StackPanel x:Name="CodexSessionWindowSection">
                                <Grid Margin="0,0,0,2" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Text="OpenAI 5h"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LineHeight="15"
                                               Foreground="#FFE8E8E8"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="CodexSessionResetText"
                                               Grid.Column="1"
                                               Margin="6,0,6,0"
                                               FontSize="9"
                                               LineHeight="12"
                                               Foreground="#FF777777"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="CodexSessionPercentText"
                                               Grid.Column="2"
                                               Text=""
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LineHeight="15"
                                               Foreground="#FFE8E8E8"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Grid x:Name="CodexSessionProgressTrack" Height="6">
                                    <Border CornerRadius="3" Background="#33FFFFFF" />
                                    <Border x:Name="CodexSessionProgressFill"
                                            CornerRadius="3"
                                            HorizontalAlignment="Left"
                                            Width="0"
                                            Background="#FF4CAF50" />
                                </Grid>
                            </StackPanel>
                            <StackPanel x:Name="CodexWeeklyWindowSection">
                                <Grid Margin="0,0,0,2" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Text="OpenAI Weekly"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LineHeight="15"
                                               Foreground="#FFE8E8E8"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="CodexWeeklyResetText"
                                               Grid.Column="1"
                                               Margin="6,0,6,0"
                                               FontSize="9"
                                               LineHeight="12"
                                               Foreground="#FF777777"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="CodexWeeklyPercentText"
                                               Grid.Column="2"
                                               Text=""
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LineHeight="15"
                                               Foreground="#FFE8E8E8"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Grid x:Name="CodexWeeklyProgressTrack" Height="6">
                                    <Border CornerRadius="3" Background="#33FFFFFF" />
                                    <Border x:Name="CodexWeeklyProgressFill"
                                            CornerRadius="3"
                                            HorizontalAlignment="Left"
                                            Width="0"
                                            Background="#FF4CAF50" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="CodexRemainingText"
                           Text=""
                           FontSize="11"
                           LineHeight="15"
                           Foreground="#FFB0B0B0" />
            </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="ClaudeProviderSection">
                <Border x:Name="ClaudeProviderHeader"
                        Background="Transparent"
                        Margin="0,0,0,4"
                        IsVisible="False">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Claude"
                                   FontFamily="Segoe UI Semibold, Segoe UI, sans-serif"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFB0B0B0" />
                        <Grid x:Name="ClaudeHeadlineTrack"
                              Height="6">
                            <Border CornerRadius="3" Background="#33FFFFFF" />
                            <Border x:Name="ClaudeHeadlineFill"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    Width="0"
                                    Background="#FF4CAF50" />
                        </Grid>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="ClaudeDetailsPanel" IsVisible="True">
            <StackPanel x:Name="ClaudeDirectSection" Margin="0,0,0,4" Spacing="2">
                <TextBlock Text="Claude API"
                           FontFamily="Segoe UI Semibold, Segoe UI, sans-serif"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#FFB0B0B0" />
                <Grid x:Name="ClaudeDirectProgressTrack"
                      Height="6">
                    <Border CornerRadius="3" Background="#33FFFFFF" />
                    <Border x:Name="ClaudeDirectProgressFill"
                            CornerRadius="3"
                            HorizontalAlignment="Left"
                            Width="0"
                            Background="#FF4CAF50" />
                </Grid>
            </StackPanel>
            <TextBlock x:Name="ClaudeDirectDetailText"
                       Margin="0,2,0,4"
                       FontSize="9"
                       LineHeight="12"
                       Foreground="#FF777777"
                       IsVisible="False" />
            <StackPanel x:Name="ClaudeProLimitsSection" IsVisible="False">
                <TextBlock x:Name="ClaudeProPercentText"
                           Text="..."
                           FontSize="11"
                           FontWeight="SemiBold"
                           LineHeight="15"
                           Foreground="#FFE8E8E8" />
                <Border x:Name="ClaudeProBarBorder"
                        Background="Transparent">
                    <StackPanel Margin="0,5,0,5" Spacing="2">
                        <TextBlock Text="Claude.ai"
                                   FontFamily="Segoe UI Semibold, Segoe UI, sans-serif"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFB0B0B0" />
                        <Grid x:Name="ClaudeProProgressTrack"
                              Height="6">
                            <Border CornerRadius="3" Background="#33FFFFFF" />
                            <Border x:Name="ClaudeProProgressFill"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    Width="0"
                                    Background="#FF4CAF50" />
                        </Grid>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="ClaudeProBreakdownSection"
                            IsVisible="False">
                    <Border x:Name="ClaudeProBreakdownPanel"
                            Margin="0,3,0,0"
                            Padding="6,5"
                            CornerRadius="5"
                            Background="#FF252525">
                        <StackPanel Spacing="5">
                            <StackPanel>
                                <Grid Margin="0,0,0,2" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Text="Claude 5h"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LineHeight="15"
                                               Foreground="#FFE8E8E8"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ClaudeProSessionResetText"
                                               Grid.Column="1"
                                               Margin="6,0,6,0"
                                               FontSize="9"
                                               LineHeight="12"
                                               Foreground="#FF777777"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ClaudeProSessionPercentText"
                                               Grid.Column="2"
                                               Text=""
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LineHeight="15"
                                               Foreground="#FFE8E8E8"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Grid x:Name="ClaudeProSessionProgressTrack" Height="6">
                                    <Border CornerRadius="3" Background="#33FFFFFF" />
                                    <Border x:Name="ClaudeProSessionProgressFill"
                                            CornerRadius="3"
                                            HorizontalAlignment="Left"
                                            Width="0"
                                            Background="#FF4CAF50" />
                                </Grid>
                            </StackPanel>
                            <StackPanel>
                                <Grid Margin="0,0,0,2" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Text="Claude Weekly"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LineHeight="15"
                                               Foreground="#FFE8E8E8"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ClaudeProWeeklyResetText"
                                               Grid.Column="1"
                                               Margin="6,0,6,0"
                                               FontSize="9"
                                               LineHeight="12"
                                               Foreground="#FF777777"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ClaudeProWeeklyPercentText"
                                               Grid.Column="2"
