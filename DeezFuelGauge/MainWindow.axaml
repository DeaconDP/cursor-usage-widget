                           IsVisible="False" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="0">
                    <TextBlock Text="built by "
                               FontSize="8.5"
                               LineHeight="12"
                               Foreground="#44FFFFFF"
                               VerticalAlignment="Center" />
                    <TextBlock Text="deac.online"
                               FontSize="8.5"
                               LineHeight="12"
                               Foreground="#55AAAAAA"
                               Cursor="Hand"
                               VerticalAlignment="Center"
                               PointerPressed="DeacLink_PointerPressed" />
                    <TextBlock Text=" @ "
                               FontSize="8.5"
                               LineHeight="12"
                               Foreground="#44FFFFFF"
                               VerticalAlignment="Center" />
                    <TextBlock Text="worldbuild.io"
                               FontSize="8.5"
                               LineHeight="12"
                               Foreground="#55AAAAAA"
                               Cursor="Hand"
                               VerticalAlignment="Center"
                               PointerPressed="WorldbuildLink_PointerPressed" />
                </StackPanel>
            </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
